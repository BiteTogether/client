    "@react-navigation/stack": "^7.4.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@rneui/base": "4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "@shopify/flash-list": "1.7.6",
    "@types/styled-components": "^5.1.34",
    "axios": "^1.11.0",
